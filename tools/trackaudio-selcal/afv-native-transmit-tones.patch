+bool ATCRadioSimulation::transmitTones(const std::vector<ToneSegment> &segments) {
+    constexpr double fadeMs = 5.0;   // short fade in/out on each segment so there are no clicks
+    std::deque<audio::SampleType> out;
+    unsigned int totalMs = 0;
+    for (const auto &seg: segments) {
+        totalMs += seg.durationMs;
+    }
+    if (segments.empty() || totalMs == 0 || totalMs > maxToneSequenceMs) {
+        return false;
+    }
+    for (const auto &seg: segments) {
+        const size_t n    = static_cast<size_t>(seg.durationMs) * audio::sampleRateHz / 1000;
+        const size_t fade = static_cast<size_t>(fadeMs * audio::sampleRateHz / 1000);
+        const int    tones = (seg.freq1Hz > 0 ? 1 : 0) + (seg.freq2Hz > 0 ? 1 : 0);
+        const double amp   = tones ? std::min(1.0f, std::max(0.0f, seg.gain)) / tones : 0.0;
+        for (size_t i = 0; i < n; i++) {
+            const double t = static_cast<double>(i) / audio::sampleRateHz;
+            double       v = 0;
+            if (seg.freq1Hz > 0) {
+                v += sin(2.0 * M_PI * seg.freq1Hz * t);
+            }
+            if (seg.freq2Hz > 0) {
+                v += sin(2.0 * M_PI * seg.freq2Hz * t);
+            }
+            double env = 1.0;
+            if (i < fade) {
+                env = static_cast<double>(i) / fade;
+            } else if (n - i <= fade) {
+                env = static_cast<double>(n - i) / fade;
+            }
+            out.push_back(static_cast<audio::SampleType>(amp * env * v));
+        }
+    }
+    // pad to whole frames, then one silent frame so the final tone frame is sent while the transmitter is still keyed
+    while (out.size() % audio::frameSizeSamples != 0) {
+        out.push_back(0);
+    }
+    out.insert(out.end(), audio::frameSizeSamples, 0);
+
+    std::lock_guard<std::mutex> toneGuard(mToneLock);
+    if (!mToneSamples.empty()) {
+        return false;
+    }
+    mToneSamples = std::move(out);
+    mToneDeadlineMs.store(nowMs() + totalMs + 1500);   // normal end is when the frames run out; this only matters if the microphone stops delivering frames
+    mToneTx.store(true);
+    return true;
+}
+
+bool ATCRadioSimulation::isTransmittingTones() const {
+    return mToneTx.load();
+}
+
+void ATCRadioSimulation::cancelTones() {
+    std::lock_guard<std::mutex> toneGuard(mToneLock);
+    mToneSamples.clear();
+    mToneTx.store(false);
+}
